{
    "manifest_version": 3,
    "name": "Breathe",
    "version": "1.0",
    "description": "Pauses before opening distracting websites",
    "icons": {},
    "browser_specific_settings": {
        "gecko": {
            "id": "Offbeatsofa@tuckerdrown.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "block/block.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "settings/settings.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}